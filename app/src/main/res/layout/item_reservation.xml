<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" app:cardCornerRadius="12dp" app:cardUseCompatPadding="true">

    <LinearLayout android:padding="12dp"
        android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitle"
            android:text="Vườn nướng BBQ - S101" android:textStyle="bold" android:textSize="16sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_marginTop="4dp"
            android:text="16/10/2025 • 19:00 • 2 NL, 0 TE"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_marginTop="6dp"
            android:text="PENDING"
            android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF9800" android:background="#1FFF9800"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
